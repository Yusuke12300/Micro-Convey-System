# Arm_Controller CMake config file
#
# This file sets the following variables:
# Arm_Controller_FOUND - Always TRUE.
# Arm_Controller_INCLUDE_DIRS - Directories containing the Arm_Controller include files.
# Arm_Controller_IDL_DIRS - Directories containing the Arm_Controller IDL files.
# Arm_Controller_LIBRARIES - Libraries needed to use Arm_Controller.
# Arm_Controller_DEFINITIONS - Compiler flags for Arm_Controller.
# Arm_Controller_VERSION - The version of Arm_Controller found.
# Arm_Controller_VERSION_MAJOR - The major version of Arm_Controller found.
# Arm_Controller_VERSION_MINOR - The minor version of Arm_Controller found.
# Arm_Controller_VERSION_REVISION - The revision version of Arm_Controller found.
# Arm_Controller_VERSION_CANDIDATE - The candidate version of Arm_Controller found.

message(STATUS "Found Arm_Controller-@PROJECT_VERSION@")
set(Arm_Controller_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Arm_Controller_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Arm_Controller_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Arm_Controller_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Arm_Controller_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Arm_Controller_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Arm_Controller_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Arm_Controller_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Arm_Controller_VERSION @PROJECT_VERSION@)
set(Arm_Controller_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Arm_Controller_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Arm_Controller_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Arm_Controller_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

