# Dummy_hand_test CMake config file
#
# This file sets the following variables:
# Dummy_hand_test_FOUND - Always TRUE.
# Dummy_hand_test_INCLUDE_DIRS - Directories containing the Dummy_hand_test include files.
# Dummy_hand_test_IDL_DIRS - Directories containing the Dummy_hand_test IDL files.
# Dummy_hand_test_LIBRARIES - Libraries needed to use Dummy_hand_test.
# Dummy_hand_test_DEFINITIONS - Compiler flags for Dummy_hand_test.
# Dummy_hand_test_VERSION - The version of Dummy_hand_test found.
# Dummy_hand_test_VERSION_MAJOR - The major version of Dummy_hand_test found.
# Dummy_hand_test_VERSION_MINOR - The minor version of Dummy_hand_test found.
# Dummy_hand_test_VERSION_REVISION - The revision version of Dummy_hand_test found.
# Dummy_hand_test_VERSION_CANDIDATE - The candidate version of Dummy_hand_test found.

message(STATUS "Found Dummy_hand_test-@PROJECT_VERSION@")
set(Dummy_hand_test_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Dummy_hand_test_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Dummy_hand_test_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Dummy_hand_test_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Dummy_hand_test_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Dummy_hand_test_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Dummy_hand_test_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Dummy_hand_test_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Dummy_hand_test_VERSION @PROJECT_VERSION@)
set(Dummy_hand_test_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Dummy_hand_test_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Dummy_hand_test_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Dummy_hand_test_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

