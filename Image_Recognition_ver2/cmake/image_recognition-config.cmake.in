# Image_Recognition CMake config file
#
# This file sets the following variables:
# Image_Recognition_FOUND - Always TRUE.
# Image_Recognition_INCLUDE_DIRS - Directories containing the Image_Recognition include files.
# Image_Recognition_IDL_DIRS - Directories containing the Image_Recognition IDL files.
# Image_Recognition_LIBRARIES - Libraries needed to use Image_Recognition.
# Image_Recognition_DEFINITIONS - Compiler flags for Image_Recognition.
# Image_Recognition_VERSION - The version of Image_Recognition found.
# Image_Recognition_VERSION_MAJOR - The major version of Image_Recognition found.
# Image_Recognition_VERSION_MINOR - The minor version of Image_Recognition found.
# Image_Recognition_VERSION_REVISION - The revision version of Image_Recognition found.
# Image_Recognition_VERSION_CANDIDATE - The candidate version of Image_Recognition found.

message(STATUS "Found Image_Recognition-@PROJECT_VERSION@")
set(Image_Recognition_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Image_Recognition_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Image_Recognition_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Image_Recognition_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Image_Recognition_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Image_Recognition_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Image_Recognition_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Image_Recognition_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Image_Recognition_VERSION @PROJECT_VERSION@)
set(Image_Recognition_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Image_Recognition_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Image_Recognition_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Image_Recognition_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

