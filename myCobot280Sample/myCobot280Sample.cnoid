items:
  id: 0
  name: "RootItem"
  plugin: Base
  class: RootItem
  is_builtin_item: true
  children:
    -
      id: 1
      name: "World"
      plugin: Body
      class: WorldItem
      data:
        collision_detection: false
        collision_detectors:
          -
            name: AISTCollisionDetector
            is_current: true
            primitive_shape_collision_detection: true
            contact_persistence_tolerance: 0.0005
            num_cap_circle_vertices: 16
        default_material_table_file: "${SHARE}/default/materials.yaml"
      children:
        -
          id: 2
          name: "myCobot"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            schema: 2
            file: "mycobot_280_m5/mycobot_280_m5.urdf"
            format: URDF
            root_translation: [ 0, 0, 0 ]
            root_rotation: [ 1, 0, 0, 0 ]
            joint_displacements: [ 18.8048062175, -13.7577227562, -96.2540156176, 20.0220792565, 0.0112453501905, 18.800305962 ]
            initial_joint_displacements: [ 0, 0, 0, 0, 0, 0 ]
            initial_root_translation: [ 0, 0, 0 ]
            initial_root_rotation: [ 1, 0, 0, 0 ]
            fix_root: true
            collision_detection: true
            lock_location: false
            scene_sensitive: true
            link_kinematics:
              "joint6_flange":
                base_frame: 0
                offset_frame: 0
          children:
            -
              id: 3
              name: "myCobot280Io"
              plugin: OpenRTMPython
              class: PyRTCItem
              data:
                relativePathBaseType: "Project directory"
                moduleName: "myCobotIo/myCobot280Io.py"
                executionContext: "SimulatorExecutionContext"
        -
          id: 5
          name: "myCobot280Sample"
          plugin: OpenRTM
          class: RTSystemItem
          data:
            filename: "myCobot280Sample.xml"
            format: RTS-PROFILE-XML
            autoConnection: true
            pollingCycle: 1000
            stateCheckMode: Polling
            checkAtLoading: true
            heartBeatPeriod: 500
        -
          id: 6
          name: "ArmController"
          plugin: OpenRTM
          class: RTCItem
          data:
            module: "${HOME}/workspace2/ArmController/build/src/ArmController.so"
            baseDirectory: "None"
            periodicType: PeriodicExecutionContext
            periodicRate: 1000
            activation: false
        -
          id: 7
          name: "AISTSimulator"
          plugin: Body
          class: AISTSimulatorItem
          data:
            time_step: 0.001
            realtime_sync_mode: compensatory
            recording: tail
            time_range_mode: unlimited
            time_length: 300
            is_active_control_time_range_mode: false
            output_all_link_positions: false
            output_device_states: true
            use_controller_threads: true
            record_collision_data: false
            controller_options: ""
            block_scene_view_edit_mode: false
            time_sync_items: [ 4 ]
            dynamics_mode: "Forward dynamics"
            integration_mode: semi-implicit_euler
            gravity: [ 0, 0, -9.80665 ]
            min_friction_coefficient: 0
            max_friction_coefficient: 100
            contact_culling_distance: 0.005
            contact_culling_depth: 0.05
            error_criterion: 0.001
            max_num_iterations: 25
            num_collision_detection_threads: 0
            max_num_contact_points: 4
            contact_correction_depth: 0.00025
            contact_correction_velocity_ratio: 5
views:
  -
    id: 0
    plugin: Base
    class: ItemPropertyView
    mounted: true
  -
    id: 1
    plugin: Base
    class: ItemTreeView
    mounted: true
    state:
      expanded: [ 1, 2, 3, 5, 7 ]
  -
    id: 2
    plugin: Base
    class: LocationView
    mounted: true
    state:
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      coordinate: world
  -
    id: 3
    plugin: Base
    class: MessageView
    mounted: true
  -
    id: 4
    plugin: Base
    class: SceneView
    mounted: true
    state:
      operation_mode: view
      viewpoint_operation_mode: third_person
      focus_position: [ 0.0533918, 0.064399, 0.0020017 ]
      visible_polygon_elements: [ face ]
      highlighting: false
      collision_highlighting: false
      collision_lines: false
      cameras:
        -
          camera: Perspective
          is_current: true
          eye: [ 0.915627, 0.354556, 0.4854 ]
          direction: [ -0.906203, -0.314096, -0.283089 ]
          up: [ -0.267477, -0.0927096, 0.959094 ]
        -
          camera: Orthographic
          ortho_height: 20
      lighting_mode: normal
      culling_mode: enabled
      shading_mode: smooth
      world_light: true
      world_light_intensity: 0.5
      ambient_light: true
      ambient_light_intensity: 0.5
      head_light: true
      head_light_intensity: 0.5
      world_light_shadow: true
      shadow_lights:
        - { index: 0, enabled: false }
        - { index: 1, enabled: false }
      background_color: [ 0.1, 0.1, 0.3 ]
      line_width: 1
      point_size: 1
      field_of_view: 35
      clip_distances: [ 0.04, 200 ]
      infinite_far_clip: true
      floor_grid: true
      floor_grid_span: 10
      floor_grid_interval: 0.5
      xz_grid: false
      xz_grid_span: 10
      xz_grid_interval: 0.5
      yz_grid: false
      yz_grid_span: 10
      yz_grid_interval: 0.5
      xy_grid_color: [ 0.9, 0.9, 0.9 ]
      xz_grid_color: [ 0.9, 0.9, 0.9 ]
      yz_grid_color: [ 0.9, 0.9, 0.9 ]
  -
    id: 5
    plugin: Body
    class: JointDisplacementView
    mounted: true
    state:
      show_joint_ids: true
      show_joint_names: false
      overlap_joint_names: false
      show_sliders: true
      show_dials: false
      show_phases: true
      limit_ranges: false
      show_selected_joints: false
  -
    id: 6
    plugin: Body
    class: LinkDeviceListView
    mounted: true
    state:
      element_type: all
      listing_mode: list
      current_body_item: 2
      body_items:
        -
          id: 2
          selected_links: [ 7 ]
  -
    id: 7
    plugin: Body
    class: LinkPositionView
    mounted: true
    state:
      coordinate_mode: base
      preferred_coordinate_mode: base
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      target_link_type: ik_link
  -
    id: 8
    plugin: Body
    class: LinkPropertyView
    mounted: true
  -
    id: 9
    plugin: OpenRTM
    class: RTSConfigurationView
    mounted: true
  -
    id: 10
    plugin: OpenRTM
    class: RTSDiagramView
    mounted: true
    state:
      currentRTSItem: 5
  -
    id: 11
    plugin: OpenRTM
    class: RTSNameServerView
    mounted: true
    state:
      NameServers:
        -
          isDefaultNameServer: true
          host: "localhost"
          port: 2809
  -
    id: 12
    plugin: Python
    class: PythonConsoleView
    mounted: true
toolbars:
  "TimeBar":
    current_time: 16.344
    min_time: 0
    max_time: 245.547
    frame_rate: 1000
    playback_frame_rate: 60
    idle_loop_driven_mode: false
    playback_speed_ratio: 1
    sync_to_ongoing_updates: true
    auto_expansion: true
  "LeggedBodyBar":
    stanceWidth: 0.15
  "KinematicsBar":
    forward_kinematics: true
    inverse_kinematics: true
    preset_kinematics: true
    enablePositionDragger: true
    penetrationBlock: false
    snapDistance: 0.025
    penetrationBlockDepth: 0.0005
    lazyCollisionDetectionMode: true
Body:
  "BodySelectionManager":
    current_body_item: 2
    current_link: "joint6_flange"
  "KinematicFaultChecker":
    checkJointPositions: true
    angleMargin: 0
    translationMargin: 0
    checkJointVelocities: true
    velocityLimitRatio: 100
    targetJoints: all
    checkSelfCollisions: true
    onlyTimeBarRange: false
  "OperableSceneBody":
    scene_bodies:
      -
        body_item: 2
        show_cm: false
        show_cm_projection: false
        show_zmp: false
  "SplineFilterDialog":
    isInputFrameRateSpecified: false
    inputFrameRate: 200
    isOutputFrameRateSpecified: false
    outputFrameRate: 200
OpenRTM:
  "deleteUnmanagedRTCsOnStartingSimulation": false
view_areas:
  -
    type: embedded
    tabs: true
    contents:
      type: splitter
      orientation: horizontal
      sizes: [ 1454, 462 ]
      children:
        -
          type: splitter
          orientation: horizontal
          sizes: [ 375, 1075 ]
          children:
            -
              type: splitter
              orientation: vertical
              sizes: [ 420, 418 ]
              children:
                -
                  type: pane
                  views: [ 1 ]
                -
                  type: pane
                  views: [ 0, 8, 11 ]
                  current: 11
            -
              type: splitter
              orientation: vertical
              sizes: [ 573, 265 ]
              children:
                -
                  type: pane
                  views: [ 4 ]
                -
                  type: pane
                  views: [ 3, 12, 9 ]
                  current: 9
        -
          type: splitter
          orientation: vertical
          sizes: [ 328, 510 ]
          children:
            -
              type: pane
              views: [ 2, 10 ]
              current: 10
            -
              type: splitter
              orientation: vertical
              sizes: [ 338, 168 ]
              children:
                -
                  type: pane
                  views: [ 7 ]
                -
                  type: pane
                  views: [ 6, 5 ]
                  current: 5
toolbar_layout:
  rows:
    -
      - { name: "FileBar", x: 0, priority: 0 }
      - { name: "ScriptBar", x: 0, priority: 1 }
      - { name: "SimulationBar", x: 0, priority: 2 }
      - { name: "TimeBar", x: 0, priority: 0 }
    -
      - { name: "BodyBar", x: 0, priority: 0 }
      - { name: "KinematicsBar", x: 0, priority: 1 }
      - { name: "SceneBar", x: 0, priority: 2 }
      - { name: "GraphBar", x: 0, priority: 3 }
      - { name: "CaptureBar", x: 0, priority: 4 }
      - { name: "DisplayValueFormatBar", x: 0, priority: 5 }
