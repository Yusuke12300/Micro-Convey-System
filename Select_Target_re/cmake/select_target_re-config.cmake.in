# Select_Target_re CMake config file
#
# This file sets the following variables:
# Select_Target_re_FOUND - Always TRUE.
# Select_Target_re_INCLUDE_DIRS - Directories containing the Select_Target_re include files.
# Select_Target_re_IDL_DIRS - Directories containing the Select_Target_re IDL files.
# Select_Target_re_LIBRARIES - Libraries needed to use Select_Target_re.
# Select_Target_re_DEFINITIONS - Compiler flags for Select_Target_re.
# Select_Target_re_VERSION - The version of Select_Target_re found.
# Select_Target_re_VERSION_MAJOR - The major version of Select_Target_re found.
# Select_Target_re_VERSION_MINOR - The minor version of Select_Target_re found.
# Select_Target_re_VERSION_REVISION - The revision version of Select_Target_re found.
# Select_Target_re_VERSION_CANDIDATE - The candidate version of Select_Target_re found.

message(STATUS "Found Select_Target_re-@PROJECT_VERSION@")
set(Select_Target_re_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Select_Target_re_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Select_Target_re_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Select_Target_re_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Select_Target_re_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Select_Target_re_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Select_Target_re_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Select_Target_re_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Select_Target_re_VERSION @PROJECT_VERSION@)
set(Select_Target_re_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Select_Target_re_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Select_Target_re_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Select_Target_re_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

