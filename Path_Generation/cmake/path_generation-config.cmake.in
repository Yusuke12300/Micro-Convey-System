# Path_Generation CMake config file
#
# This file sets the following variables:
# Path_Generation_FOUND - Always TRUE.
# Path_Generation_INCLUDE_DIRS - Directories containing the Path_Generation include files.
# Path_Generation_IDL_DIRS - Directories containing the Path_Generation IDL files.
# Path_Generation_LIBRARIES - Libraries needed to use Path_Generation.
# Path_Generation_DEFINITIONS - Compiler flags for Path_Generation.
# Path_Generation_VERSION - The version of Path_Generation found.
# Path_Generation_VERSION_MAJOR - The major version of Path_Generation found.
# Path_Generation_VERSION_MINOR - The minor version of Path_Generation found.
# Path_Generation_VERSION_REVISION - The revision version of Path_Generation found.
# Path_Generation_VERSION_CANDIDATE - The candidate version of Path_Generation found.

message(STATUS "Found Path_Generation-@PROJECT_VERSION@")
set(Path_Generation_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Path_Generation_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Path_Generation_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Path_Generation_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Path_Generation_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Path_Generation_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Path_Generation_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Path_Generation_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Path_Generation_VERSION @PROJECT_VERSION@)
set(Path_Generation_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Path_Generation_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Path_Generation_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Path_Generation_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

