# Hand_Controller CMake config file
#
# This file sets the following variables:
# Hand_Controller_FOUND - Always TRUE.
# Hand_Controller_INCLUDE_DIRS - Directories containing the Hand_Controller include files.
# Hand_Controller_IDL_DIRS - Directories containing the Hand_Controller IDL files.
# Hand_Controller_LIBRARIES - Libraries needed to use Hand_Controller.
# Hand_Controller_DEFINITIONS - Compiler flags for Hand_Controller.
# Hand_Controller_VERSION - The version of Hand_Controller found.
# Hand_Controller_VERSION_MAJOR - The major version of Hand_Controller found.
# Hand_Controller_VERSION_MINOR - The minor version of Hand_Controller found.
# Hand_Controller_VERSION_REVISION - The revision version of Hand_Controller found.
# Hand_Controller_VERSION_CANDIDATE - The candidate version of Hand_Controller found.

message(STATUS "Found Hand_Controller-@PROJECT_VERSION@")
set(Hand_Controller_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(Hand_Controller_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(Hand_Controller_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(Hand_Controller_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(Hand_Controller_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(Hand_Controller_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(Hand_Controller_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(Hand_Controller_DEFINITIONS ${<dependency>_DEFINITIONS})

set(Hand_Controller_VERSION @PROJECT_VERSION@)
set(Hand_Controller_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Hand_Controller_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Hand_Controller_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(Hand_Controller_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

